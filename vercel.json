{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{node_modules/swagger-ui-dist/**,node_modules/onnxruntime-node/bin/napi-v3/linux/x64/**}",
      "maxDuration": 30,
      "excludeFiles": "{node_modules/onnxruntime-node/bin/napi-v3/darwin/**,node_modules/onnxruntime-node/bin/napi-v3/win32/**,node_modules/onnxruntime-node/bin/napi-v3/linux/arm64/**}",
      "memory": 2048
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/jobs/tick",
      "schedule": "0 6 * * *"
    }
  ]
}
