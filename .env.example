# Copier en .env et remplir. Ne jamais committer de vraies valeurs.
DATABASE_URL="postgresql://ganji:ganji@localhost:5432/ganji?schema=public"
DATABASE_URL_UNPOOLED="postgresql://ganji:ganji@localhost:5432/ganji?schema=public"
# 32 octets en base64 : openssl rand -base64 32
FIELD_ENCRYPTION_KEY=""
# Clé HMAC pour le NPI et la signature des ordonnances : openssl rand -base64 32
HMAC_KEY=""
# Secret de signature des sessions : openssl rand -base64 48
JWT_SECRET=""
# Secret partagé pour les tâches planifiées (Vercel Cron)
CRON_SECRET=""
# URL publique du frontend (liens dans les SMS)
PUBLIC_APP_URL="http://localhost:3000"
# Mode démo : active les comptes de démonstration et le simulateur SMS
DEMO_MODE="true"
